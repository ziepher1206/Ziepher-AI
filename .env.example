# Web application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PREVIEW_ORIGIN=http://localhost:3000
NEXT_TELEMETRY_DISABLED=1

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Provider credentials are encrypted before persistence. Supply a random 32-byte
# key encoded as base64. Never expose this value to the browser or generated apps.
ZIEPHER_PROVIDER_CREDENTIALS_KEY=

# GitHub OAuth connection used by Ziepher's guarded source-control workflow.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# AI routing.
# OpenAI is the default paid provider when configured. A second paid provider is
# never tried automatically unless ZIEPHER_AI_ALLOW_PAID_FALLBACK=true.
# Deterministic generation remains the zero-cost fallback.
ZIEPHER_AI_PRIMARY_PROVIDER=openai
ZIEPHER_AI_ALLOW_PAID_FALLBACK=false

# OpenAI — retained as Ziepher's primary configured AI provider.
# Keep model IDs explicit so production behavior and cost never change silently.
OPENAI_API_KEY=
OPENAI_PLANNING_MODEL=gpt-5.6-luna
OPENAI_BUILD_MODEL=gpt-5.6-terra
OPENAI_ESCALATION_MODEL=gpt-5.6-sol

# Gemini remains optional. Configure it only when you intentionally want to use
# Gemini as the primary provider or as an explicitly enabled paid fallback.
GOOGLE_AI_API_KEY=
GOOGLE_PLANNING_MODEL=gemini-3.1-flash-lite
GOOGLE_BUILD_MODEL=gemini-3.5-flash
GOOGLE_ESCALATION_MODEL=gemini-3.1-pro-preview

# Build worker
BUILD_WORKER_ID=local-build-worker-1
BUILD_WORKER_POLL_MS=3000
BUILD_RUNNER_EXECUTION=docker
BUILD_RUNNER_IMAGE=node:22-bookworm
BUILD_RUNNER_MAX_SECONDS=600
BUILD_MAX_REPAIRS=1
ALLOW_UNSANDBOXED_RUNNER=false
BUILD_WORK_ROOT=.ziepher-builds

# Deployment worker. Preview deployments remain separately governed by
# VERCEL_DEPLOYMENTS_ENABLED. Live production releases require the additional
# explicit production flag and owner/admin action in Ziepher.
DEPLOYMENT_WORKER_ID=local-deployment-worker-1
DEPLOYMENT_WORKER_POLL_MS=5000
VERCEL_DEPLOYMENTS_ENABLED=false
VERCEL_PRODUCTION_RELEASES_ENABLED=false
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Stripe remains off until the complete core application passes release gates.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BUILDER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_BUILDER_ANNUAL_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=

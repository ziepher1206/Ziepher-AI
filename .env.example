# Web application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PREVIEW_ORIGIN=http://localhost:3000
NEXT_TELEMETRY_DISABLED=1

# Desktop bridge uses this exact hosted origin in packaged clients. Local Tauri
# development may set ZIEPHER_APP_URL=http://localhost:3000.
ZIEPHER_APP_URL=https://app.ziepher.ai

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI routing. Planning is free to the Ziepher user.
GOOGLE_AI_API_KEY=
GOOGLE_PLANNING_MODEL=gemini-3.1-flash-lite
GOOGLE_BUILD_MODEL=gemini-3.5-flash
GOOGLE_ESCALATION_MODEL=gemini-3.1-pro-preview

# OpenAI is an optional fallback. Set model IDs explicitly so model changes
# never silently alter production behavior.
OPENAI_API_KEY=
OPENAI_PLANNING_MODEL=
OPENAI_BUILD_MODEL=
OPENAI_ESCALATION_MODEL=

# Build worker
BUILD_WORKER_ID=local-build-worker-1
BUILD_WORKER_POLL_MS=3000
BUILD_RUNNER_EXECUTION=docker
BUILD_RUNNER_IMAGE=node:22-bookworm
BUILD_RUNNER_MAX_SECONDS=600
BUILD_MAX_REPAIRS=1
ALLOW_UNSANDBOXED_RUNNER=false
BUILD_WORK_ROOT=.ziepher-builds

# Deployment worker. Vercel remains disabled until staging release gates pass.
DEPLOYMENT_WORKER_ID=local-deployment-worker-1
DEPLOYMENT_WORKER_POLL_MS=5000
VERCEL_DEPLOYMENTS_ENABLED=false
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Stripe remains off until the complete core application passes release gates.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BUILDER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_BUILDER_ANNUAL_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=

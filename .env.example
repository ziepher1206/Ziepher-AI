# Web application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PREVIEW_ORIGIN=http://localhost:3000
NEXT_TELEMETRY_DISABLED=1

# Community/local development.
# Keep this true in forks and ordinary contributor environments. Community work
# should use fake data and mock provider behavior unless the contributor chooses
# to configure their own development-only provider account.
ZLIFE_DEV_MODE=true
ZLIFE_MOCK_AI=true
ZLIFE_MOCK_EMAIL=true
ZLIFE_MOCK_SMS=true
ZLIFE_MOCK_PAYMENTS=true
ZLIFE_MOCK_NOTIFICATIONS=true

# Reserved for the future Global Impact program. Intentionally unset until an
# exact percentage and legal/accounting structure are explicitly approved.
GLOBAL_IMPACT_PERCENTAGE=

# Supabase — community contributors should use their own development project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub contribution ingestion. Leave the secret blank in forks/local work
# unless testing with a contributor-owned development webhook. Production stays
# fail-closed until a maintainer configures a signing secret and allowlist.
GITHUB_COMMUNITY_WEBHOOK_SECRET=
GITHUB_COMMUNITY_ALLOWED_REPOSITORIES=ziepher1206/Ziepher-AI

# Provider credentials are encrypted before persistence. Supply a random 32-byte
# key encoded as base64. Never expose this value to the browser or generated apps.
ZIEPHER_PROVIDER_CREDENTIALS_KEY=

# GitHub OAuth connection used by Ziepher's guarded source-control workflow.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# AI routing.
# OpenAI is the default paid provider when configured. A second paid provider is
# never tried automatically unless ZIEPHER_AI_ALLOW_PAID_FALLBACK=true.
# Deterministic generation remains the zero-cost fallback.
ZIEPHER_AI_PRIMARY_PROVIDER=openai
ZIEPHER_AI_ALLOW_PAID_FALLBACK=false

# Live paid AI also requires an explicit positive monthly provider budget.
# Keep this blank by default so live AI fails closed. For a controlled pilot,
# set a deliberately small amount only after the owner approves paid usage.
ZLIFE_AI_MONTHLY_PROVIDER_BUDGET_USD=

# OpenAI — retained as Ziepher's primary configured AI provider.
# Keep model IDs explicit so production behavior and cost never change silently.
OPENAI_API_KEY=
OPENAI_PLANNING_MODEL=gpt-5.6-luna
OPENAI_BUILD_MODEL=gpt-5.6-terra
OPENAI_ESCALATION_MODEL=gpt-5.6-sol
# Live calls fail closed unless each operation has an explicit output bound.
OPENAI_PLANNING_MAX_OUTPUT_TOKENS=4000
OPENAI_BUILD_MAX_OUTPUT_TOKENS=12000
OPENAI_AGENT_MAX_OUTPUT_TOKENS=4000

# Ziepher specialist agent team.
# Keep live execution disabled until a run-level budget/approval policy is active.
# When enabled, OPENAI_AGENT_MODEL is used for specialist runs; if blank, the
# planning model is used. The /team UI remains zero-cost unless live execution
# is explicitly wired into an approved workflow.
ZIEPHER_AGENT_LIVE_ENABLED=false
OPENAI_AGENT_MODEL=

# Gemini remains optional. Configure it only when you intentionally want to use
# Gemini as the primary provider or as an explicitly enabled paid fallback.
GOOGLE_AI_API_KEY=
GOOGLE_PLANNING_MODEL=gemini-3.1-flash-lite
GOOGLE_BUILD_MODEL=gemini-3.5-flash
GOOGLE_ESCALATION_MODEL=gemini-3.1-pro-preview

# Build worker
BUILD_WORKER_ID=local-build-worker-1
BUILD_WORKER_POLL_MS=3000
BUILD_RUNNER_EXECUTION=docker
BUILD_RUNNER_IMAGE=node:22-bookworm
BUILD_RUNNER_MAX_SECONDS=600
BUILD_MAX_REPAIRS=1
ALLOW_UNSANDBOXED_RUNNER=false
BUILD_WORK_ROOT=.ziepher-builds

# Deployment worker. Vercel access tokens are connected per workspace in
# Settings -> Connected rails and stored encrypted in provider_connections.
# No global operator Vercel token is used for customer project deployments.
# Deployment and production-release rails remain disabled unless the operator
# explicitly configures their runtime gates after provider verification.
DEPLOYMENT_WORKER_ID=local-deployment-worker-1
DEPLOYMENT_WORKER_POLL_MS=5000

# Stripe remains off until the complete core application passes release gates.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BUILDER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_BUILDER_ANNUAL_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=

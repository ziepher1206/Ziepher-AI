FROM node:22.16.0-bookworm-slim

WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN apt-get update   && apt-get install -y --no-install-recommends docker.io ca-certificates git   && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

CMD ["npm", "run", "worker"]
